# Copy this file to .env and fill in real values for local development.
# .env is loaded automatically by springboot4-dotenv (see pom.xml) and must never be committed.

# RabbitMQ connection used by spring.rabbitmq.* in application.yaml
# NOTE: this must be the AMQP port (default 5672), not the management UI port (15672).
NWK_RABBITMQ_HOST=localhost
NWK_RABBITMQ_PORT=5672
NWK_RABBITMQ_USERNAME=guest
NWK_RABBITMQ_PASSWORD=guest

# SMTP connection used by spring.mail.* in application.yaml, to deliver OTP emails
NWK_MAIL_HOST=smtp.gmail.com
NWK_MAIL_PORT=587
NWK_MAIL_USERNAME=changeme@example.com
NWK_MAIL_PASSWORD=changeme
