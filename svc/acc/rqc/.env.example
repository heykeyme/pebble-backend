# Copy this file to .env and fill in real values for local development.
# .env is loaded automatically by springboot4-dotenv (see pom.xml) and must never be committed.

# PostgreSQL connection used by spring.datasource.* in application.yaml
RQC_DB_URL=jdbc:postgresql://localhost:5432/rqc
RQC_DB_USERNAME=rqc
RQC_DB_PASSWORD=changeme

RQC_SERVER_PORT=8080
