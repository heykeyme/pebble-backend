# Copy this file to .env and fill in real values for local development.
# .env is loaded automatically by springboot4-dotenv (see pom.xml) and must never be committed.

# PostgreSQL connection used by spring.datasource.* in application.yaml (same users table as emc)
RQC_DB_URL=jdbc:postgresql://localhost:5432/users
RQC_DB_USERNAME=rqc
RQC_DB_PASSWORD=changeme

# Redis connection used by spring.data.redis.* in application.yaml (stores OTPs, 5 min TTL)
RQC_REDIS_HOST=localhost
RQC_REDIS_PORT=6379
RQC_REDIS_PASSWORD=changeme

# RabbitMQ connection used by spring.rabbitmq.* in application.yaml
# NOTE: this must be the AMQP port (default 5672), not the management UI port (15672).
RQC_RABBITMQ_HOST=localhost
RQC_RABBITMQ_PORT=5672
RQC_RABBITMQ_USERNAME=guest
RQC_RABBITMQ_PASSWORD=guest

RQC_SERVER_PORT=8081
