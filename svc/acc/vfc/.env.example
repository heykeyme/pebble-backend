# Copy this file to .env and fill in real values for local development.
# .env is loaded automatically by springboot4-dotenv (see pom.xml) and must never be committed.

# PostgreSQL connection used by spring.datasource.* in application.yaml (same users table as emc/rqc)
VFC_DB_URL=jdbc:postgresql://localhost:5432/users
VFC_DB_USERNAME=vfc
VFC_DB_PASSWORD=changeme

VFC_SERVER_PORT=8088
